{
  "name": "rit-website",
  "private": true,
  "description": "Responsible IT website: Eleventy site built from the markdown in content/",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate-content.mjs",
    "sketches": "node scripts/render-sketches.mjs",
    "build": "npm run validate && eleventy",
    "dev": "eleventy --serve --port=8080",
    "check": "node scripts/check-site.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.8",
    "@11ty/eleventy-img": "7.1.1",
    "js-yaml": "4.1.0",
    "markdown-it": "14.1.0",
    "playwright": "1.62.0"
  }
}
